# Copy this file to .env before first run:  cp .env.example .env
# Everything here stays on your machine. Nothing is uploaded to a vendor.

# --- PostgreSQL (used by docker-compose to create the DB, and by the backend to connect) ---
POSTGRES_USER=pdftoolkit
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=pdftoolkit
DATABASE_URL=postgresql+psycopg://pdftoolkit:change-me-locally@postgres:5432/pdftoolkit

# --- Backend (FastAPI) ---
# Where documents/versions/previews/backups live inside the backend container.
# Mapped to ./data on the host by docker-compose -- this IS your local file store.
DATA_DIR=/data
MAX_UPLOAD_MB=200
# Leave empty for "keep forever". Set a number of days to auto-expire new uploads by default.
DEFAULT_RETENTION_DAYS=
SOFFICE_BIN=soffice
OCR_LANGUAGES=eng
CORS_ORIGINS=http://localhost:3000
PURGE_INTERVAL_SECONDS=3600

# Base URL the backend uses to build signer links (must be reachable by whoever you invite).
APP_BASE_URL=http://localhost:3000

# Optional: SMTP for signature invitation emails. Leave blank to only generate
# local signing links (you share them yourself) -- delivery outcome is still logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
